# Copy this file to .env and fill every empty required value.
# Never commit .env.

SERVER_PORT=8080

# First-start bootstrap accounts.
# Leave MIND_BRIDGE_ADMIN_PASSWORD empty to skip creating an administrator.
MIND_BRIDGE_ADMIN_USERNAME=admin
MIND_BRIDGE_ADMIN_PASSWORD=
MIND_BRIDGE_STUDENT_USERNAME=student
MIND_BRIDGE_STUDENT_PASSWORD=

# Database (required for docker compose)
DB_USERNAME=mindbridge
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# AI provider
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mindbridge-qwen2.5-7b-ft:latest
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Retrieval and MCP
USE_CHROMA=true
CHROMA_BASE_URL=http://chroma:8000
MCP_SERVER_ENABLED=true
MCP_EMAIL_MODE=log
MAIL_HOST=mailpit
MAIL_PORT=1025